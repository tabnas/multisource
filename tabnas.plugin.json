{
  "$schema": "https://tabnas.dev/schema/plugin.schema.json",
  "name": "@tabnas/multisource",
  "go": "github.com/tabnas/multisource/go",
  "rust": "tabnas-multisource",
  "description": "Multi-source document assembly for the tabnas engine: resolves and merges included sources.",
  "base": "@tabnas/directive",
  "engine": "@tabnas/parser",
  "specDir": "test/spec",
  "clib": {
    "dir": "go/clib",
    "library": "libtabnasmultisource",
    "abi": "v1",
    "errorCodes": [
      "usage",
      "grammar",
      "handle",
      "internal"
    ]
  },
  "errorCodes": [
    "multisource_not_found",
    "multisource_cycle"
  ],
  "docs": "https://tabnas.dev/docs/packages",
  "repository": "https://github.com/tabnas/multisource",
  "versionSource": "ts/package.json"
}
